# OlivoScan: copiar como .env.local y completar con valores propios.
# No subir .env.local ni credenciales reales a GitHub.

# Supabase: autenticacion y base de datos
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key-de-supabase
# Solo servidor: nunca usar el prefijo NEXT_PUBLIC_ para esta clave.
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key-de-supabase

# Cloudinary: almacenamiento de imagenes (solo servidor)
CLOUDINARY_CLOUD_NAME=tu-cloud-name
CLOUDINARY_API_KEY=tu-api-key
CLOUDINARY_API_SECRET=tu-api-secret

# Gemini: completar para habilitar el diagnostico real
GEMINI_API_KEY=tu-gemini-api-key
# Opcional: si queda vacio, el codigo utiliza su modelo predeterminado.
GEMINI_MODEL=

# Integraciones alternativas opcionales: dejar vacias si no se usan.
HUGGINGFACE_API_URL=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
